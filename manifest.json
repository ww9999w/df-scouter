{
  "manifest_version": 3,
  "name": "DF Scouter · 댓글 캐릭터 정보",
  "version": "2.5.2",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "댓글에서 선택한 캐릭터의 공식 프로필 정보를 매번 새로 조회하고 동일 캐릭터 댓글에 함께 표시합니다.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://df.nexon.com/*", "https://resource.df.nexon.com/*",
    "https://bbscdn.df.nexon.com/*", "https://avatar.df.nexon.com/*", "https://img-api.neople.co.kr/*",
    "https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [{
    "resources": ["assets/*.png"],
    "matches": ["https://df.nexon.com/*"]
  }],
  "content_scripts": [{
    "matches": ["https://df.nexon.com/*"],
    "js": ["vendor/dom-to-image-more.min.js", "profile.js", "content.js", "capture.js"],
    "css": ["content.css"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
